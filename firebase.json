{
  "hosting": {
    "public": "haunt-roll-fail",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/avalon/**",
        "destination": "/avalon.html"
      },
      {
        "source": "/avalon",
        "destination": "/avalon.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
